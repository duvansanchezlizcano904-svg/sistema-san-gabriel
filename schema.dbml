// ==============================================================
// BASE DE DATOS: Gabriel Lácteos - Diagrama Entidad-Relación (DBML)
// Para usar en https://dbdiagram.io
// ==============================================================

Table usuarios {
  id int [pk, increment]
  nombre varchar(100) [not null]
  usuario varchar(50) [unique, not null]
  password varchar(255) [not null]
  email varchar(100)
  rol varchar(20) [not null, default: 'cliente', note: 'Enum: administrador, cliente']
  creado_en timestamp [default: `CURRENT_TIMESTAMP`]
}

Table productos {
  id int [pk, increment]
  codigo varchar(30) [unique, not null]
  nombre varchar(120) [not null]
  tipo varchar(60) [not null]
  descripcion text
  precio_compra decimal(10,2) [not null, default: 0.00]
  precio_venta decimal(10,2) [not null, default: 0.00]
  cantidad int [not null, default: 0]
  stock_minimo int [not null, default: 5]
  unidad_medida varchar(30) [not null, default: 'Kilogramo']
  estado varchar(20) [not null, default: 'activo', note: 'Enum: activo, inactivo']
  creado_en timestamp [default: `CURRENT_TIMESTAMP`]
}

Table ventas {
  id int [pk, increment]
  numero_venta varchar(30) [unique, not null]
  fecha datetime [not null, default: `CURRENT_TIMESTAMP`]
  total decimal(10,2) [not null, default: 0.00]
  cliente varchar(100) [default: 'Cliente Mostrador']
  notas text
  usuario_id int
}

Table detalle_ventas {
  id int [pk, increment]
  venta_id int [not null]
  producto_id int [not null]
  cantidad int [not null]
  precio_unitario decimal(10,2) [not null]
  subtotal decimal(10,2) [not null]
}

// Relaciones (Foreign Keys)
Ref: ventas.usuario_id > usuarios.id [delete: set null, update: cascade]
Ref: detalle_ventas.venta_id > ventas.id [delete: cascade, update: cascade]
Ref: detalle_ventas.producto_id > productos.id [delete: restrict, update: cascade]
